# Что git НЕ должен сохранять в репозиторий.
# Аналогия: список вещей, которые не берём в переезд — их легко создать заново.

# "Песочница" Python с установленными библиотеками (создаётся командой venv)
.venv/

# Скачанные PDF (кеш парсера)
parser/.cache/
__pycache__/

# Сгенерированное расписание — его создаёт GitHub Actions при каждом запуске
web/public/data/

# Библиотеки Node.js и собранный сайт
node_modules/
web/dist/

# Мусор macOS
.DS_Store
